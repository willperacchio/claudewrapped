  "description": "Your year in Claude Code, Spotify Wrapped style. 100% local — nothing leaves your machine.",
  "bin": {
    "claudewrapped": "bin/claudewrapped.js"
  },
  "files": [
    "bin",
    "lib",
    "web"
  ],
  "scripts": {
